@model UserDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết tài khoản - " + Model.UserName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-details.css" />
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        @* <h2 class="mb-1">
            <i class="fas fa-user-circle"></i> Chi tiết tài khoản
        </h2> *@
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Users" asp-action="Index">Người dùng</a></li>
                <li class="breadcrumb-item active">@Model.UserName</li>
            </ol>
        </nav>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary">
            <i class="fas fa-edit"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <!-- Thông tin cá nhân -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-id-card"></i> Thông tin cá nhân</h5>
            </div>
            <div class="card-body">
                <!-- Avatar placeholder -->
                <div class="text-center mb-4">
                    <div class="avatar-placeholder bg-primary text-white rounded-circle mx-auto d-flex align-items-center justify-content-center"
                         style="width: 120px; height: 120px; font-size: 48px;">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4 class="mt-3 mb-1">@(Model.FullName ?? Model.UserName)</h4>
                    <p class="text-muted mb-2">@@@Model.UserName</p>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-check-circle"></i> Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            <i class="fas fa-times-circle"></i> Ngừng hoạt động
                        </span>
                    }
                </div>

                <!-- Thông tin chi tiết -->
                <div class="user-info-list">
                    <div class="user-info-item">
                        <i class="fas fa-fingerprint text-muted"></i>
                        <div>
                            <small class="text-muted d-block">ID</small>
                            <strong>#@Model.UserId</strong>
                        </div>
                    </div>

                    <div class="user-info-item">
                        <i class="fas fa-envelope text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Email</small>
                            <strong>@(Model.Email ?? "Chưa cập nhật")</strong>
                        </div>
                    </div>

                    <div class="user-info-item">
                        <i class="fas fa-phone text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Số điện thoại</small>
                            <strong>@(Model.Phone ?? "Chưa cập nhật")</strong>
                        </div>
                    </div>

                    <div class="user-info-item">
                        <i class="fas fa-calendar-plus text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Ngày tạo</small>
                            <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    </div>

                    <div class="user-info-item">
                        <i class="fas fa-sign-in-alt text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Đăng nhập lần cuối</small>
                            @if (Model.LastLoginAt.HasValue)
                            {
                                <strong>@Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                            }
                            else
                            {
                                <span class="text-muted">Chưa đăng nhập</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* <!-- Thống kê -->
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar"></i> Thống kê hoạt động</h5>
            </div>
            <div class="card-body">
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value text-primary">@Model.TotalRecognitions</div>
                        <div class="stat-label">Tổng số lần nhận dạng</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value text-success">@Model.RecognitionsThisMonth</div>
                        <div class="stat-label">Nhận dạng tháng này</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value text-warning">@Model.RecognitionsToday</div>
                        <div class="stat-label">Nhận dạng hôm nay</div>
                    </div>
                </div>
                @if (Model.TotalRecognitions == 0)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        <i class="fas fa-info-circle"></i>
                        Chưa có hoạt động nhận dạng nào được ghi nhận.
                    </div>
                }
            </div>
        </div> *@
    </div>

    <!-- Vai trò và Quyền hạn -->
    <div class="col-lg-8 mb-4">
        <!-- Vai trò -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-user-tag"></i> Vai trò</h5>
                <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-sm btn-light">
                    <i class="fas fa-edit"></i> Chỉnh sửa
                </a>
            </div>
            <div class="card-body">
                @if (Model.Roles != null && Model.Roles.Any())
                {
                    <div class="row">
                        @foreach (var role in Model.Roles)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="role-card p-3 border rounded">
                                    <div class="d-flex align-items-start">
                                        <div class="role-icon bg-success bg-opacity-10 text-success rounded p-2 me-3">
                                            <i class="fas fa-shield-alt fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">@role.Name</h6>
                                            <small class="text-muted">@(role.Description ?? "Không có mô tả")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Người dùng chưa được gán vai trò nào. Vui lòng gán vai trò để cấp quyền truy cập.
                    </div>
                }
            </div>
        </div>

        <!-- Quyền hạn -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-key"></i> Quyền hạn</h5>
            </div>
            <div class="card-body">
                @if (Model.Permissions != null && Model.Permissions.Any())
                {
                    var groupedPermissions = Model.Permissions.GroupBy(p => p.Category ?? "Khác");

                    <div class="accordion" id="permissionsAccordion">
                        @{
                            int accordionIndex = 0;
                        }
                        @foreach (var group in groupedPermissions)
                        {
                            var collapseId = "collapse" + accordionIndex;
                            var headingId = "heading" + accordionIndex;
                            accordionIndex++;

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button @(accordionIndex == 1 ? "" : "collapsed")" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                            aria-expanded="@(accordionIndex == 1 ? "true" : "false")" aria-controls="@collapseId">
                                        <i class="fas fa-folder me-2"></i>
                                        <strong>@group.Key</strong>
                                        <span class="badge bg-primary ms-2">@group.Count()</span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(accordionIndex == 1 ? "show" : "")"
                                     aria-labelledby="@headingId" data-bs-parent="#permissionsAccordion">
                                    <div class="accordion-body">
                                        <div class="row">
                                            @foreach (var permission in group)
                                            {
                                                <div class="col-md-6 mb-2">
                                                    <div class="permission-item p-2 border-start border-3 border-success bg-light">
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-check-circle text-success me-2"></i>
                                                            <div>
                                                                <strong class="d-block">@permission.Name</strong>
                                                                <small class="text-muted">@permission.Code</small>
                                                                @if (!string.IsNullOrEmpty(permission.Description))
                                                                {
                                                                    <br />
                                                                    <small class="text-muted fst-italic">@permission.Description</small>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Người dùng không có quyền hạn nào. Điều này xảy ra khi chưa được gán vai trò hoặc vai trò chưa có quyền.
                    </div>
                }
            </div>
        </div>

        <!-- Hoạt động gần đây -->
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-history"></i> Hoạt động gần đây</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Hành động</th>
                                    <th>Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in Model.RecentActivities)
                                {
                                    <tr>
                                        <td>@activity.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge bg-info">@activity.Action</span></td>
                                        <td>@activity.Detail</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle"></i>
                        Chưa có hoạt động nào được ghi nhận.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
