@model Camera
@{
    ViewData["Title"] = "Quét Camera";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - @ViewBag.CameraName</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/camera.css" />
</head>
<body>
    <div class="scan-container">
        <!-- Header -->
        <div class="scan-header">
            <h1>
                <i class="fas fa-video"></i> @ViewBag.CameraName
            </h1>
            <p>Quét biển số xe</p>
        </div>

        <!-- Camera Preview -->
        <div class="camera-preview">
            <video id="cameraVideo" autoplay playsinline></video>
            <canvas id="canvas"></canvas>
            <div class="preview-overlay"></div>
        </div>

        <!-- Controls -->
        <div class="scan-controls">
            <button class="capture-btn" id="captureBtn">
                <i class="fas fa-camera"></i>
            </button>
        </div>

        <!-- Loading -->
        <div class="scan-loading" id="loadingDiv">
            <div class="spinner-border text-light" role="status"></div>
            <p class="mt-3">Đang nhận dạng...</p>
        </div>

        <!-- Result -->
        <div class="scan-result" id="resultDiv">
            <div class="result-success">
                <i class="fas fa-check-circle"></i>
                <h4>Nhận dạng thành công!</h4>
            </div>
            <div class="result-plate" id="resultPlate"></div>
            <div class="result-meta" id="resultMeta"></div>
            <div class="d-grid gap-2">
                <button class="btn btn-primary" onclick="continueScan()">
                    <i class="fas fa-camera"></i> Quét tiếp
                </button>
                <a href="/Recognition/History" class="btn btn-outline-primary">
                    <i class="fas fa-history"></i> Xem lịch sử
                </a>
            </div>
        </div>

        <!-- Error -->
        <div class="alert alert-danger m-3" id="errorDiv" style="display: none;">
            <i class="fas fa-exclamation-triangle"></i>
            <span id="errorMessage"></span>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        const video = document.getElementById('cameraVideo');
        const canvas = document.getElementById('canvas');
        const captureBtn = document.getElementById('captureBtn');
        const loadingDiv = document.getElementById('loadingDiv');
        const resultDiv = document.getElementById('resultDiv');
        const errorDiv = document.getElementById('errorDiv');
        const cameraId = @ViewBag.CameraId;

        // Khởi động camera
        async function startCamera() {
            try {
                const constraints = {
                    video: {
                        facingMode: 'environment', // Camera sau
                        width: { ideal: 1920 },
                        height: { ideal: 1080 }
                    }
                };

                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = stream;

                // Thiết lập canvas size theo video
                video.addEventListener('loadedmetadata', () => {
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                });
            } catch (error) {
                showError('Không thể truy cập camera. Vui lòng cấp quyền camera cho trình duyệt.');
                console.error('Camera error:', error);
            }
        }

        // Chụp và nhận dạng
        captureBtn.addEventListener('click', async () => {
            // Chụp ảnh từ video
            const context = canvas.getContext('2d');
            context.drawImage(video, 0, 0, canvas.width, canvas.height);

            // Chuyển canvas thành blob
            canvas.toBlob(async (blob) => {
                if (!blob) {
                    showError('Không thể chụp ảnh');
                    return;
                }

                // Hiển thị loading
                loadingDiv.classList.add('show');
                captureBtn.disabled = true;
                resultDiv.classList.remove('show');
                errorDiv.style.display = 'none';

                // Tạo FormData
                const formData = new FormData();
                formData.append('ImageFile', blob, 'capture.jpg');
                formData.append('CameraId', cameraId);
                formData.append('Direction', 'In'); // Mặc định là Vào

                try {
                    // Gửi lên server
                    const response = await fetch('/Recognition/Recognize', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        // Hiển thị kết quả
                        displayResult(result);
                    } else {
                        showError(result.message || 'Không nhận dạng được biển số');
                    }
                } catch (error) {
                    showError('Có lỗi xảy ra khi gửi ảnh');
                    console.error('Upload error:', error);
                } finally {
                    loadingDiv.classList.remove('show');
                    captureBtn.disabled = false;
                }
            }, 'image/jpeg', 0.95);
        });

        // Hiển thị kết quả
        function displayResult(result) {
            document.getElementById('resultPlate').textContent = result.plateNorm || result.plateTextRaw || 'N/A';

            let metaHtml = '';
            if (result.confidence) {
                metaHtml += `<span><i class="fas fa-percentage"></i> ${result.confidence.toFixed(1)}%</span>`;
            }
            if (result.region) {
                metaHtml += `<span><i class="fas fa-map-marker-alt"></i> ${result.region}</span>`;
            }
            if (result.detectedAt) {
                const time = new Date(result.detectedAt).toLocaleTimeString('vi-VN');
                metaHtml += `<span><i class="fas fa-clock"></i> ${time}</span>`;
            }

            document.getElementById('resultMeta').innerHTML = metaHtml;
            resultDiv.classList.add('show');

            // Phát âm thanh thành công (nếu có)
            try {
                const audio = new Audio('data:audio/wav;base64,');
                audio.play().catch(() => {});
            } catch (e) {}
        }

        // Hiển thị lỗi
        function showError(message) {
            document.getElementById('errorMessage').textContent = message;
            errorDiv.style.display = 'block';
            setTimeout(() => {
                errorDiv.style.display = 'none';
            }, 5000);
        }

        // Quét tiếp
        function continueScan() {
            resultDiv.classList.remove('show');
        }

        // Khởi động khi trang load
        window.addEventListener('load', () => {
            startCamera();
        });

        // Ngăn màn hình tắt
        if ('wakeLock' in navigator) {
            let wakeLock = null;
            const requestWakeLock = async () => {
                try {
                    wakeLock = await navigator.wakeLock.request('screen');
                } catch (err) {
                    console.log('Wake Lock error:', err);
                }
            };
            requestWakeLock();
        }
    </script>
</body>
</html>
