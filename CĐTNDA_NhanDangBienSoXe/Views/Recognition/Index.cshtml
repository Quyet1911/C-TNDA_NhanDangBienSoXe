@model RecognitionIndexViewModel
@{
    ViewData["Title"] = "Quét biển số xe";
}

@section Styles {
    <link rel="stylesheet" href="~/css/recognition.css" />
    <style>
        /* Tabs Style */
        .method-tabs {
            display: flex;
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 20px;
        }

        .method-tab {
            flex: 1;
            padding: 12px 20px;
            text-align: center;
            cursor: pointer;
            border: none;
            background: transparent;
            font-weight: 600;
            color: #6c757d;
            transition: all 0.3s ease;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
        }

        .method-tab:hover {
            color: #28a745;
            background: rgba(40, 167, 69, 0.05);
        }

        .method-tab.active {
            color: #28a745;
            border-bottom-color: #28a745;
        }

        .method-tab i {
            margin-right: 8px;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Camera Section */
        .camera-section {
            position: relative;
        }

        .camera-view {
            position: relative;
            background: #000;
            border-radius: 10px;
            overflow: hidden;
            min-height: 300px;
        }

        .camera-view video {
            width: 100%;
            max-height: 400px;
            object-fit: contain;
        }

        .camera-view canvas {
            display: none;
        }

        .camera-overlay-frame {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80%;
            height: 60%;
            border: 3px solid rgba(40, 167, 69, 0.8);
            border-radius: 8px;
            pointer-events: none;
        }

        .camera-controls-bar {
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 0 0 10px 10px;
        }

        .camera-error {
            display: none;
            text-align: center;
            padding: 40px;
            color: #6c757d;
        }

        .camera-error i {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.5;
        }

        /* Auto scan toggle inline */
        .auto-scan-inline {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            background: #e9ecef;
            border-radius: 20px;
        }

        .auto-scan-inline label {
            margin: 0;
            font-size: 0.9rem;
            cursor: pointer;
        }

        .switch-sm {
            position: relative;
            width: 40px;
            height: 22px;
        }

        .switch-sm input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider-sm {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.3s;
            border-radius: 22px;
        }

        .slider-sm:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }

        .switch-sm input:checked + .slider-sm {
            background-color: #28a745;
        }

        .switch-sm input:checked + .slider-sm:before {
            transform: translateX(18px);
        }

        .scanning-badge {
            display: none;
            align-items: center;
            gap: 5px;
            color: #28a745;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .scanning-badge.active {
            display: flex;
        }

        .scanning-badge .dot {
            width: 8px;
            height: 8px;
            background: #28a745;
            border-radius: 50%;
            animation: blink 1s infinite;
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
    </style>
}

<div class="recognition-container">
    <div class="recognition-header">
        <h1 class="page-title">
            <i class="fas fa-qrcode"></i> Quét biển số xe
        </h1>
        <a href="/Recognition/History" class="btn btn-outline-primary">
            <i class="fas fa-history"></i> Xem lịch sử
        </a>
    </div>

    <div class="recognition-main">
        <!-- Left Panel: Input Section -->
        <div class="upload-panel">
            <div class="panel-card">
                <div class="panel-header">
                    <h3><i class="fas fa-camera"></i> Nhập ảnh</h3>
                </div>
                <div class="panel-body">
                    <!-- Method Tabs -->
                    <div class="method-tabs">
                        <button class="method-tab active" data-tab="camera">
                            <i class="fas fa-video"></i> Quét Camera
                        </button>
                        <button class="method-tab" data-tab="upload">
                            <i class="fas fa-upload"></i> Tải ảnh lên
                        </button>
                    </div>

                    <!-- Camera Tab -->
                    <div class="tab-content active" id="tab-camera">
                        <div class="camera-section">
                            <div class="camera-view">
                                <video id="cameraVideo" autoplay playsinline></video>
                                <canvas id="cameraCanvas"></canvas>
                                <div class="camera-overlay-frame"></div>
                            </div>
                            <div class="camera-error" id="cameraError">
                                <i class="fas fa-video-slash"></i>
                                <p>Không thể truy cập camera</p>
                                <button class="btn btn-primary btn-sm" onclick="startCameraStream()">
                                    <i class="fas fa-redo"></i> Thử lại
                                </button>
                            </div>
                            <div class="camera-controls-bar">
                                <div class="auto-scan-inline">
                                    <label class="switch-sm">
                                        <input type="checkbox" id="autoScanToggle">
                                        <span class="slider-sm"></span>
                                    </label>
                                    <label for="autoScanToggle">Tự động</label>
                                    <span class="scanning-badge" id="scanningBadge">
                                        <span class="dot"></span> Đang quét
                                    </span>
                                </div>
                                <button class="btn btn-success" id="captureBtn">
                                    <i class="fas fa-camera"></i> Chụp
                                </button>
                                <button class="btn btn-secondary" id="switchCamBtn">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Direction for Camera -->
                        <div class="form-group mt-3">
                            <label><i class="fas fa-arrows-alt-h"></i> Hướng di chuyển</label>
                            <div class="direction-options">
                                <label class="direction-option">
                                    <input type="radio" name="CameraDirection" value="In" checked>
                                    <span class="direction-badge direction-in">
                                        <i class="fas fa-arrow-right"></i> Vào
                                    </span>
                                </label>
                                <label class="direction-option">
                                    <input type="radio" name="CameraDirection" value="Out">
                                    <span class="direction-badge direction-out">
                                        <i class="fas fa-arrow-left"></i> Ra
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Upload Tab -->
                    <div class="tab-content" id="tab-upload">
                        <form id="uploadForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <!-- File Upload Area -->
                            <div class="upload-zone" id="uploadZone">
                                <input type="file" id="imageFile" name="ImageFile" accept="image/*" style="display: none;">
                                <div class="upload-placeholder" id="uploadPlaceholder">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <p>Kéo ảnh vào đây</p>
                                    <button type="button" class="btn" onclick="document.getElementById('imageFile').click()">
                                        <i class="fas fa-folder-open"></i> Chọn ảnh
                                    </button>
                                    <small class="text-muted d-block mt-2">Hỗ trợ: JPG, PNG, BMP (Tối đa 10MB)</small>
                                </div>
                                <div class="upload-preview" id="uploadPreview" style="display: none;">
                                    <img id="previewImage" src="" alt="Preview">
                                    <button type="button" class="btn-remove" onclick="clearImage()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Camera Selection (Optional) -->
                            <div class="form-group mt-3">
                                <label><i class="fas fa-video"></i> Camera (Tùy chọn)</label>
                                <select class="form-select" name="CameraId">
                                    <option value="">-- Chọn camera --</option>
                                    @foreach (var camera in Model.AvailableCameras)
                                    {
                                        <option value="@camera.CameraId">
                                            @camera.Name @(camera.LocationNote != null ? $"({camera.LocationNote})" : "")
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Direction Selection -->
                            <div class="form-group mt-3">
                                <label><i class="fas fa-arrows-alt-h"></i> Hướng di chuyển</label>
                                <div class="direction-options">
                                    <label class="direction-option">
                                        <input type="radio" name="Direction" value="In" checked>
                                        <span class="direction-badge direction-in">
                                            <i class="fas fa-arrow-right"></i> Vào
                                        </span>
                                    </label>
                                    <label class="direction-option">
                                        <input type="radio" name="Direction" value="Out">
                                        <span class="direction-badge direction-out">
                                            <i class="fas fa-arrow-left"></i> Ra
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <!-- Upload Button -->
                            <button type="submit" class="btn btn-success btn-block mt-4" id="uploadBtn">
                                <i class="fas fa-search"></i> Nhận dạng ngay
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Result Section -->
        <div class="result-panel">
            <div class="panel-card">
                <div class="panel-header">
                    <h3><i class="fas fa-check-circle"></i> Kết quả</h3>
                </div>
                <div class="panel-body">
                    <div class="result-empty" id="resultEmpty">
                        <i class="fas fa-inbox"></i>
                        <p>Chưa có kết quả nhận dạng</p>
                        <small>Quét camera hoặc tải ảnh lên để nhận dạng</small>
                    </div>

                    <div class="result-content" id="resultContent" style="display: none;">
                        <!-- Loading State -->
                        <div class="result-loading" id="resultLoading" style="display: none;">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-3">Đang nhận dạng...</p>
                        </div>

                        <!-- Success Result -->
                        <div class="result-success" id="resultSuccess" style="display: none;">
                            <div class="result-image">
                                <img id="resultImg" src="" alt="Detected plate">
                            </div>

                            <div class="plate-info">
                                <div class="plate-number">
                                    <i class="fas fa-car"></i>
                                    <span id="plateText">--</span>
                                </div>
                                <div class="confidence-bar">
                                    <label>Độ tin cậy</label>
                                    <div class="progress">
                                        <div class="progress-bar" id="confidenceBar" role="progressbar" style="width: 0%">
                                            <span id="confidenceText">0%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="result-meta">
                                <div class="meta-item">
                                    <i class="fas fa-clock"></i>
                                    <span id="detectedTime">--</span>
                                </div>
                            </div>

                            <div class="alert alert-success">
                                <i class="fas fa-check-circle"></i>
                                <span id="resultMessage">Nhận dạng thành công!</span>
                            </div>
                        </div>

                        <!-- Error Result -->
                        <div class="result-error" id="resultError" style="display: none;">
                            <i class="fas fa-exclamation-circle"></i>
                            <p id="errorMessage">Có lỗi xảy ra</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ==================== TABS ====================
        const tabs = document.querySelectorAll('.method-tab');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                // Remove active from all
                tabs.forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                // Add active to clicked
                tab.classList.add('active');
                document.getElementById('tab-' + tab.dataset.tab).classList.add('active');

                // Start camera if camera tab
                if (tab.dataset.tab === 'camera') {
                    startCameraStream();
                } else {
                    stopCameraStream();
                }
            });
        });

        // ==================== CAMERA ====================
        const video = document.getElementById('cameraVideo');
        const canvas = document.getElementById('cameraCanvas');
        const captureBtn = document.getElementById('captureBtn');
        const switchCamBtn = document.getElementById('switchCamBtn');
        const autoScanToggle = document.getElementById('autoScanToggle');
        const scanningBadge = document.getElementById('scanningBadge');
        const cameraError = document.getElementById('cameraError');

        let cameraStream = null;
        let useFrontCam = false;
        let isAutoScanning = false;
        let autoScanInterval = null;
        let isProcessing = false;
        let lastPlate = '';

        // Start Camera
        async function startCameraStream() {
            try {
                if (cameraStream) {
                    cameraStream.getTracks().forEach(t => t.stop());
                }

                cameraError.style.display = 'none';
                video.style.display = 'block';

                const constraints = {
                    video: {
                        facingMode: useFrontCam ? 'user' : 'environment',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                };

                cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = cameraStream;

                video.onloadedmetadata = () => {
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                };
            } catch (err) {
                console.error('Camera error:', err);
                video.style.display = 'none';
                cameraError.style.display = 'block';
            }
        }

        // Stop Camera
        function stopCameraStream() {
            stopAutoScan();
            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }
        }

        // Switch Camera
        switchCamBtn.addEventListener('click', () => {
            useFrontCam = !useFrontCam;
            startCameraStream();
        });

        // Capture
        captureBtn.addEventListener('click', () => {
            if (!cameraStream || isProcessing) return;
            captureAndRecognize();
        });

        // Auto Scan Toggle
        autoScanToggle.addEventListener('change', (e) => {
            if (e.target.checked) {
                startAutoScan();
            } else {
                stopAutoScan();
            }
        });

        function startAutoScan() {
            if (isAutoScanning) return;
            isAutoScanning = true;
            scanningBadge.classList.add('active');
            captureBtn.disabled = true;
            autoScanInterval = setInterval(autoCapture, 1500);
        }

        function stopAutoScan() {
            isAutoScanning = false;
            scanningBadge.classList.remove('active');
            captureBtn.disabled = false;
            if (autoScanInterval) {
                clearInterval(autoScanInterval);
                autoScanInterval = null;
            }
        }

        async function autoCapture() {
            if (!cameraStream || isProcessing) return;
            isProcessing = true;

            try {
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                const blob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.9));
                if (!blob) { isProcessing = false; return; }

                const direction = document.querySelector('input[name="CameraDirection"]:checked')?.value || 'In';
                const formData = new FormData();
                formData.append('ImageFile', blob, 'capture.jpg');
                formData.append('Direction', direction);

                const response = await fetch('/Recognition/Recognize', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success && result.plateNorm && result.plateNorm !== lastPlate) {
                    lastPlate = result.plateNorm;
                    showSuccess(result);
                    playSound();

                    // Pause auto scan
                    clearInterval(autoScanInterval);
                    setTimeout(() => {
                        if (isAutoScanning) {
                            autoScanInterval = setInterval(autoCapture, 1500);
                        }
                        setTimeout(() => { lastPlate = ''; }, 5000);
                    }, 3000);
                }
            } catch (err) {
                console.error('Auto capture error:', err);
            } finally {
                isProcessing = false;
            }
        }

        async function captureAndRecognize() {
            isProcessing = true;
            showLoading();
            captureBtn.disabled = true;

            try {
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                const blob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.95));
                if (!blob) {
                    showError('Không thể chụp ảnh');
                    return;
                }

                const direction = document.querySelector('input[name="CameraDirection"]:checked')?.value || 'In';
                const formData = new FormData();
                formData.append('ImageFile', blob, 'capture.jpg');
                formData.append('Direction', direction);

                const response = await fetch('/Recognition/Recognize', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    showSuccess(result);
                    playSound();
                } else {
                    showError(result.message || 'Không nhận dạng được biển số');
                }
            } catch (err) {
                showError('Lỗi: ' + err.message);
            } finally {
                captureBtn.disabled = isAutoScanning;
                isProcessing = false;
            }
        }

        function playSound() {
            try {
                new Audio('data:audio/wav;base64,').play().catch(() => {});
            } catch (e) {}
        }

        // ==================== UPLOAD ====================
        const uploadZone = document.getElementById('uploadZone');
        const uploadPlaceholder = document.getElementById('uploadPlaceholder');
        const uploadPreview = document.getElementById('uploadPreview');
        const imageFile = document.getElementById('imageFile');
        const previewImage = document.getElementById('previewImage');
        const uploadForm = document.getElementById('uploadForm');
        const uploadBtn = document.getElementById('uploadBtn');

        // Drag & Drop
        uploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadZone.classList.add('drag-over');
        });

        uploadZone.addEventListener('dragleave', () => {
            uploadZone.classList.remove('drag-over');
        });

        uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadZone.classList.remove('drag-over');
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                imageFile.files = files;
                previewImageFile(files[0]);
            }
        });

        imageFile.addEventListener('change', function () {
            if (this.files.length > 0) {
                previewImageFile(this.files[0]);
            }
        });

        function previewImageFile(file) {
            if (!file.type.startsWith('image/')) {
                alert('Vui lòng chọn file ảnh!');
                return;
            }
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImage.src = e.target.result;
                uploadPlaceholder.style.display = 'none';
                uploadPreview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        function clearImage() {
            imageFile.value = '';
            uploadPlaceholder.style.display = 'flex';
            uploadPreview.style.display = 'none';
            hideResult();
        }

        uploadForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            if (!imageFile.files.length) {
                alert('Vui lòng chọn ảnh!');
                return;
            }

            const formData = new FormData(uploadForm);
            showLoading();
            uploadBtn.disabled = true;

            try {
                const response = await fetch('/Recognition/UploadImage', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    showSuccess(result);
                } else {
                    showError(result.message);
                }
            } catch (error) {
                showError('Lỗi kết nối: ' + error.message);
            } finally {
                uploadBtn.disabled = false;
            }
        });

        // ==================== RESULT ====================
        function showLoading() {
            document.getElementById('resultEmpty').style.display = 'none';
            document.getElementById('resultContent').style.display = 'block';
            document.getElementById('resultLoading').style.display = 'block';
            document.getElementById('resultSuccess').style.display = 'none';
            document.getElementById('resultError').style.display = 'none';
        }

        function showSuccess(result) {
            document.getElementById('resultEmpty').style.display = 'none';
            document.getElementById('resultContent').style.display = 'block';
            document.getElementById('resultLoading').style.display = 'none';
            document.getElementById('resultSuccess').style.display = 'block';
            document.getElementById('resultError').style.display = 'none';

            document.getElementById('resultImg').src = result.imagePath || '';
            document.getElementById('plateText').textContent = result.plateNorm || result.plateText || 'N/A';
            document.getElementById('detectedTime').textContent = result.detectedAt ? new Date(result.detectedAt).toLocaleString('vi-VN') : new Date().toLocaleString('vi-VN');
            document.getElementById('resultMessage').textContent = result.message || 'Nhận dạng thành công!';

            const confidence = result.confidence || 0;
            const bar = document.getElementById('confidenceBar');
            bar.style.width = confidence + '%';
            document.getElementById('confidenceText').textContent = confidence.toFixed(1) + '%';
            bar.className = 'progress-bar ' + (confidence >= 80 ? 'bg-success' : confidence >= 60 ? 'bg-warning' : 'bg-danger');
        }

        function showError(message) {
            document.getElementById('resultEmpty').style.display = 'none';
            document.getElementById('resultContent').style.display = 'block';
            document.getElementById('resultLoading').style.display = 'none';
            document.getElementById('resultSuccess').style.display = 'none';
            document.getElementById('resultError').style.display = 'block';
            document.getElementById('errorMessage').textContent = message;
        }

        function hideResult() {
            document.getElementById('resultEmpty').style.display = 'flex';
            document.getElementById('resultContent').style.display = 'none';
        }

        // ==================== INIT ====================
        // Auto start camera on load
        if (document.querySelector('.method-tab.active[data-tab="camera"]')) {
            startCameraStream();
        }

        // Cleanup
        window.addEventListener('beforeunload', stopCameraStream);
    </script>
}
